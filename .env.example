# ─────────────────────────────────────────────────────────────────────────────
# VisionRetail AI — Environment Variables Example
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=visionretail
POSTGRES_USER=visionretail
POSTGRES_PASSWORD=visionretail_secret

# Derived DSN (used by FastAPI)
DATABASE_URL=postgresql+asyncpg://visionretail:visionretail_secret@db:5432/visionretail

# OpenAI / GPT-4o
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL=gpt-

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production

# Pipeline
YOLO_MODEL=yolov8m.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45
REID_THRESHOLD=0.65
REID_REENTRY_WINDOW_MINUTES=30
STAFF_CONFIDENCE_THRESHOLD=0.75

# Store defaults
DEFAULT_STORE_ID=STORE_BLR_002
DEFAULT_TIMEZONE=Asia/Kolkata
